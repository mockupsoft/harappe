# Vercel → Project → Settings → Environment Variables
# Aşağıdaki İSİMLERİ ekle; DEĞERLERİ kendi BULUT MySQL sağlayıcandan al (Laragon IP’si çalışmaz).
# Şifreleri bu dosyaya ve repoya ASLA yazma.

HARAPPE_DB_HOST=
HARAPPE_DB_PORT=3306
HARAPPE_DB_DATABASE=harappe
HARAPPE_DB_USERNAME=
HARAPPE_DB_PASSWORD=
HARAPPE_DB_CHARSET=utf8mb4

# Çoğu bulut MySQL için TLS aç:
HARAPPE_DB_SSL=1
# İsteğe bağlı: CA dosya yolu (sunucuda) veya PEM metni — sağlayıcı dokümantasyonuna bak
# HARAPPE_DB_SSL_CA=

# Özel domain kullanıyorsan (vercel.app dışı):
# HARAPPE_ALLOWED_ORIGINS=https://senindomainin.com

# VITE_API_URL — genelde BOŞ bırak (aynı origin /api kullanılır)
