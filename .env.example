# Harappe Vite — varsayılan 5420 (5173/3000 çakışmasını önlemek için)
VITE_DEV_PORT=5420

# Laragon: tam API kökü. Vercel’de boş bırakılabilir (aynı origin → /api).
VITE_API_URL="http://harappe.test/api"

# Vercel / sunucu: PHP PDO (HARAPPE_DB_HOST tanımlıysa config.local atlanır)
# HARAPPE_DB_HOST=
# HARAPPE_DB_PORT=3306
# HARAPPE_DB_DATABASE=harappe
# HARAPPE_DB_USERNAME=
# HARAPPE_DB_PASSWORD=
# HARAPPE_DB_CHARSET=utf8mb4
# Bulut MySQL SSL (Railway, Aiven vb.): 1 aç; CA yoksa sunucu doğrulaması kapatılır
# HARAPPE_DB_SSL=1
# İsteğe bağlı: CA dosya yolu veya PEM metni (-----BEGIN ile başlar)
# HARAPPE_DB_SSL_CA=
# İsteğe bağlı: özel domain CORS (virgülle birden fazla tam URL)
# HARAPPE_ALLOWED_ORIGINS=https://ornek.com,https://www.ornek.com
# İlk kurulumda tablolar yoksa: php scripts/import-schema.php
# (HARAPPE_DB_HOST set ise database/schema-tables.sql; Laragon’da database/schema.sql)
#
# Canlı siteden menü + görseller (public/menu/) ve MySQL menu_items:
#   npm run import-menu
# Sadece ayrıştırma: DRY_RUN=1 npm run import-menu
# Kaynak URL: HARAPPE_SOURCE_URL=https://harappe.com/ npm run import-menu
# Menü importundan sonra sipariş + favori + price_logs sıfırlanır; istemezseniz: SKIP_RESET_LEGACY=1 npm run import-menu
# Ayrı sıfırlama: npm run reset-legacy

GEMINI_API_KEY=""
APP_URL="http://localhost:5420"
